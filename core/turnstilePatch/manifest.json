{
  "manifest_version": 3,
  "name": "Turnstile Auto-Solver Fallback",
  "version": "1.0",
  "description": "Fallback auto-clicker and DOM handler for Cloudflare Turnstile",
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": [
        "*://accounts.x.ai/*",
        "*://*.x.ai/*",
        "*://*.grok.com/*",
        "*://challenges.cloudflare.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
